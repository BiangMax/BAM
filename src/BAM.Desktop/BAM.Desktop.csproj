<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>WinExe</OutputType>
    <AssemblyName>BAM</AssemblyName>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
    <ApplicationIcon>Assets/Bam.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <DefineConstants Condition="'$(EnableBamDemo)' == 'true'">$(DefineConstants);BAM_DEMO</DefineConstants>
    <DefineConstants Condition="'$(EnableBamVerification)' == 'true'">$(DefineConstants);BAM_VERIFICATION</DefineConstants>
    <OutputPath Condition="'$(EnableBamDemo)' == 'true'">bin/demo/$(Configuration)/</OutputPath>
    <IntermediateOutputPath Condition="'$(EnableBamDemo)' == 'true'">obj/demo/$(Configuration)/</IntermediateOutputPath>
    <OutputPath Condition="'$(EnableBamVerification)' == 'true'">bin/verification/$(Configuration)/</OutputPath>
    <IntermediateOutputPath Condition="'$(EnableBamVerification)' == 'true'">obj/verification/$(Configuration)/</IntermediateOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <Using Remove="System.Drawing" />
    <Using Remove="System.Windows.Forms" />
    <Resource Include="Assets/Bam.ico" />
    <InternalsVisibleTo Include="BAM.Desktop.Tests" />
    <ProjectReference Include="../BAM.Core/BAM.Core.csproj" />
    <ProjectReference Include="../BAM.Adapters/BAM.Adapters.csproj" />
    <ProjectReference Include="../BAM.Infrastructure/BAM.Infrastructure.csproj" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="WPF-UI" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
  </ItemGroup>
  <Target Name="ExcludePublishSymbols" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(ResolvedFileToPublish.Extension)' == '.pdb'" />
    </ItemGroup>
  </Target>
</Project>
