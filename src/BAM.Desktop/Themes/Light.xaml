<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
    <SolidColorBrush x:Key="Bam.Background" Color="#F3F5F8"/>
    <SolidColorBrush x:Key="Bam.Surface" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Bam.SurfaceHover" Color="#EDF2F9"/>
    <SolidColorBrush x:Key="Bam.Border" Color="#D5DCE6"/>
    <SolidColorBrush x:Key="Bam.PanelEdge" Color="#E2E7EF"/>
    <SolidColorBrush x:Key="Bam.ScrollThumb" Color="#8490A1"/>
    <SolidColorBrush x:Key="Bam.Primary" Color="#235EC2"/>
    <SolidColorBrush x:Key="Bam.PrimaryLight" Color="#1D55AB"/>
    <SolidColorBrush x:Key="Bam.ActionFill" Color="#235EC2"/>
    <SolidColorBrush x:Key="Bam.OnAction" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Bam.Success" Color="#137150"/>
    <SolidColorBrush x:Key="Bam.Warning" Color="#815410"/>
    <SolidColorBrush x:Key="Bam.Danger" Color="#A63737"/>
    <SolidColorBrush x:Key="Bam.TextPrimary" Color="#172130"/>
