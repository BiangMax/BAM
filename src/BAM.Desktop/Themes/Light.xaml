    <SolidColorBrush x:Key="Bam.Inset" Color="#F4F7FB"/>
    <SolidColorBrush x:Key="Bam.AccentSurface" Color="#E5EEFC"/>
    <SolidColorBrush x:Key="Bam.SuccessSurface" Color="#E5F2EC"/>
    <SolidColorBrush x:Key="Bam.WarningSurface" Color="#F8EFE1"/>
    <SolidColorBrush x:Key="Bam.DangerSurface" Color="#FAEBEB"/>
    <SolidColorBrush x:Key="Bam.Memory" Color="#6545AA"/>
    <SolidColorBrush x:Key="Bam.ChartGrid" Color="#DCE3ED"/>
    <DropShadowEffect x:Key="Bam.PopupShadow" Color="#172130" BlurRadius="12" ShadowDepth="3" Opacity="0.16"/>
</ResourceDictionary>
