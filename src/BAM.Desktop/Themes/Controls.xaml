<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                    xmlns:local="clr-namespace:BAM.Desktop.Controls">
    <BooleanToVisibilityConverter x:Key="Bam.VisibleWhenTrue"/>

    <Style TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Bam.Font}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="LineHeight" Value="22"/>
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight"/>
    </Style>
    <Style x:Key="Bam.PageTitle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontSize" Value="28"/>
        <Setter Property="LineHeight" Value="34"/>
        <Setter Property="FontWeight" Value="{StaticResource Bam.Weight.Emphasis}"/>
    </Style>
    <Style x:Key="Bam.SectionTitle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontSize" Value="18"/>
        <Setter Property="LineHeight" Value="24"/>
        <Setter Property="FontWeight" Value="{StaticResource Bam.Weight.Emphasis}"/>
    </Style>
    <Style x:Key="Bam.CardTitle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="LineHeight" Value="22"/>
        <Setter Property="FontWeight" Value="{StaticResource Bam.Weight.Emphasis}"/>
    </Style>
    <Style x:Key="Bam.Caption" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="LineHeight" Value="18"/>
        <Setter Property="Foreground" Value="{DynamicResource Bam.TextSecondary}"/>
    </Style>
    <Style x:Key="Bam.Muted" TargetType="TextBlock" BasedOn="{StaticResource Bam.Caption}">
        <Setter Property="Foreground" Value="{DynamicResource Bam.TextMuted}"/>
    </Style>
    <Style x:Key="Bam.MetricValue" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontSize" Value="28"/>
        <Setter Property="LineHeight" Value="32"/>
        <Setter Property="FontWeight" Value="{StaticResource Bam.Weight.Emphasis}"/>
        <Setter Property="Typography.NumeralAlignment" Value="Tabular"/>
    </Style>
    <Style x:Key="Bam.Value" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontWeight" Value="{StaticResource Bam.Weight.Emphasis}"/>
        <Setter Property="Typography.NumeralAlignment" Value="Tabular"/>
    </Style>
    <Style x:Key="Bam.CompactValue" TargetType="TextBlock" BasedOn="{StaticResource Bam.Value}">
        <Setter Property="LineHeight" Value="20"/>
    </Style>
    <Style x:Key="Bam.NavigationLabel" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontWeight" Value="{StaticResource Bam.Weight.Body}"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                <Setter Property="FontWeight" Value="{StaticResource Bam.Weight.Emphasis}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="Bam.MonoText" TargetType="TextBlock" BasedOn="{StaticResource Bam.Caption}">
        <Setter Property="FontFamily" Value="{StaticResource Bam.Mono}"/>
    </Style>
    <Style x:Key="Bam.Panel" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Bam.Surface}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Bam.PanelEdge}"/>
        <Setter Property="BorderThickness" Value="{StaticResource Bam.BorderWidth}"/>
        <Setter Property="CornerRadius" Value="{StaticResource Bam.Corner.Panel}"/>
        <Setter Property="Padding" Value="{StaticResource Bam.PanelPadding}"/>
    </Style>
    <Style x:Key="Bam.DensePanel" TargetType="Border" BasedOn="{StaticResource Bam.Panel}">
        <Setter Property="Padding" Value="{StaticResource Bam.DensePanelPadding}"/>
    </Style>
    <Style x:Key="Bam.IconTile" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Bam.AccentSurface}"/>
        <Setter Property="CornerRadius" Value="{StaticResource Bam.Corner.Control}"/>
        <Setter Property="Width" Value="40"/>
        <Setter Property="Height" Value="40"/>
    </Style>
    <Style TargetType="ui:SymbolIcon">
        <Setter Property="FontSize" Value="20"/>
        <Setter Property="Foreground" Value="{DynamicResource Bam.TextSecondary}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="Bam.AccentIcon" TargetType="ui:SymbolIcon" BasedOn="{StaticResource {x:Type ui:SymbolIcon}}">
        <Setter Property="Foreground" Value="{DynamicResource Bam.PrimaryLight}"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="Bam.FocusVisual" TargetType="Control">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border Margin="1" BorderThickness="2" CornerRadius="{StaticResource Bam.Corner.Control}"
                            BorderBrush="{DynamicResource Bam.PrimaryLight}"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Bam.ButtonBase" TargetType="ButtonBase">
        <Setter Property="FontFamily" Value="{StaticResource Bam.Font}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="{StaticResource Bam.Weight.Body}"/>
        <Setter Property="Foreground" Value="{DynamicResource Bam.TextPrimary}"/>
        <Setter Property="Background" Value="{DynamicResource Bam.Surface}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Bam.Border}"/>
        <Setter Property="BorderThickness" Value="{StaticResource Bam.BorderWidth}"/>
        <Setter Property="Padding" Value="{StaticResource Bam.ButtonPadding}"/>
        <Setter Property="MinHeight" Value="{StaticResource Bam.ControlHeight}"/>
        <Setter Property="MinWidth" Value="{StaticResource Bam.IconButtonSize}"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource Bam.FocusVisual}"/>
        <Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ButtonBase">
                    <Grid>
                        <Border x:Name="Chrome" CornerRadius="{StaticResource Bam.Corner.Control}"
                                Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"/>
                        <Border x:Name="Hover" CornerRadius="{StaticResource Bam.Corner.Control}"
                                Background="{DynamicResource Bam.PrimaryLight}" IsHitTestVisible="False" Opacity="0"
                                local:Motion.HoverFeedback="True"/>
                        <ContentPresenter Margin="{TemplateBinding Padding}" RecognizesAccessKey="True"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource Bam.TextMuted}"/>
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Bam.Inset}"/>
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Bam.Border}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="Button" BasedOn="{StaticResource Bam.ButtonBase}"/>
    <Style x:Key="Bam.PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="{DynamicResource Bam.ActionFill}"/>
        <Setter Property="Foreground" Value="{DynamicResource Bam.OnAction}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Bam.ActionFill}"/>
    </Style>
    <Style x:Key="Bam.QuietButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource Bam.PrimaryLight}"/>
    </Style>
    <Style x:Key="Bam.SectionLink" TargetType="Button" BasedOn="{StaticResource Bam.QuietButton}">
        <Setter Property="MinHeight" Value="{StaticResource Bam.IconButtonSize}"/>
    </Style>
    <Style x:Key="Bam.SegmentGroup" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Bam.Inset}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Bam.PanelEdge}"/>
        <Setter Property="BorderThickness" Value="{StaticResource Bam.BorderWidth}"/>
        <Setter Property="Padding" Value="2"/>
        <Setter Property="CornerRadius" Value="{StaticResource Bam.Corner.Control}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="Bam.Segment" TargetType="RadioButton" BasedOn="{StaticResource Bam.ButtonBase}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource Bam.TextSecondary}"/>
        <Setter Property="MinHeight" Value="{StaticResource Bam.IconButtonSize}"/>
        <Setter Property="MinWidth" Value="56"/>
        <Style.Triggers>
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="Background" Value="{DynamicResource Bam.AccentSurface}"/>
                <Setter Property="Foreground" Value="{DynamicResource Bam.PrimaryLight}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource Bam.Border}"/>
                <Setter Property="FontWeight" Value="{StaticResource Bam.Weight.Emphasis}"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="Bam.DataList" TargetType="ListBox">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
        <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
        <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True"/>
        <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/>
        <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel"/>
        <Setter Property="ItemContainerStyle">
            <Setter.Value>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Foreground" Value="{DynamicResource Bam.TextPrimary}"/>
                    <Setter Property="Padding" Value="{StaticResource Bam.RowPadding}"/>
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="FocusVisualStyle" Value="{StaticResource Bam.FocusVisual}"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <Border x:Name="Row" Background="Transparent" Padding="{TemplateBinding Padding}"
                                        BorderBrush="{DynamicResource Bam.Border}" BorderThickness="0,0,0,1"
                                        SnapsToDevicePixels="True">
                                    <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Row" Property="Background" Value="{DynamicResource Bam.SurfaceHover}"/>
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Row" Property="Background" Value="{DynamicResource Bam.AccentSurface}"/>
                                        <Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource Bam.Primary}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Bam.Input" TargetType="ui:TextBox" BasedOn="{StaticResource DefaultUiTextBoxStyle}">
        <Setter Property="FontFamily" Value="{StaticResource Bam.Font}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{DynamicResource Bam.TextPrimary}"/>
        <Setter Property="Background" Value="{DynamicResource Bam.Surface}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Bam.Border}"/>
        <Setter Property="MinHeight" Value="{StaticResource Bam.ControlHeight}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource Bam.FocusVisual}"/>
    </Style>
    <Style x:Key="Bam.Combo" TargetType="ComboBox">
        <Setter Property="FontFamily" Value="{StaticResource Bam.Font}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{DynamicResource Bam.TextPrimary}"/>
        <Setter Property="Background" Value="{DynamicResource Bam.Surface}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Bam.Border}"/>
        <Setter Property="Border.CornerRadius" Value="{StaticResource Bam.Corner.Control}"/>
        <Setter Property="MinHeight" Value="{StaticResource Bam.ControlHeight}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource Bam.FocusVisual}"/>
        <Setter Property="Padding" Value="{StaticResource Bam.ButtonPadding}"/>
        <Setter Property="BorderThickness" Value="{StaticResource Bam.BorderWidth}"/>
        <Setter Property="MaxDropDownHeight" Value="260"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton x:Name="DropButton" Style="{x:Null}" Focusable="False" ClickMode="Press"
                                      HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                      IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                      Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                      BorderThickness="{TemplateBinding BorderThickness}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Grid>
                                        <Border x:Name="ComboChrome" Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="{StaticResource Bam.Corner.Control}"/>
                                        <Border x:Name="Hover" Background="{DynamicResource Bam.PrimaryLight}"
                                                CornerRadius="{StaticResource Bam.Corner.Control}" Opacity="0"
                                                IsHitTestVisible="False" local:Motion.HoverFeedback="True"/>
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="ComboChrome" Property="BorderBrush" Value="{DynamicResource Bam.PrimaryLight}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <DockPanel Margin="{TemplateBinding Padding}" IsHitTestVisible="False" VerticalAlignment="Center">
                            <ui:SymbolIcon DockPanel.Dock="Right" Symbol="ChevronDown16" FontSize="13" Margin="{StaticResource Bam.Gap.Small}"/>
                            <ContentPresenter Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"/>
                        </DockPanel>
                        <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}"
                               AllowsTransparency="True" PopupAnimation="None" VerticalOffset="4" HorizontalOffset="-10">
                            <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                    Background="{DynamicResource Bam.Surface}" BorderBrush="{DynamicResource Bam.Border}"
                                    BorderThickness="{StaticResource Bam.BorderWidth}" CornerRadius="{StaticResource Bam.Corner.Control}"
                                    Padding="4" Margin="10,0,10,12" Effect="{DynamicResource Bam.PopupShadow}">
                                <ScrollViewer MaxHeight="{TemplateBinding MaxDropDownHeight}" CanContentScroll="True"
                                              VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Bam.Switch" TargetType="ToggleButton">
        <Setter Property="MinHeight" Value="{StaticResource Bam.ControlHeight}"/>
        <Setter Property="FontFamily" Value="{StaticResource Bam.Font}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{DynamicResource Bam.TextSecondary}"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource Bam.FocusVisual}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border Background="Transparent">
                        <DockPanel VerticalAlignment="Center">
                            <Grid Width="38" Height="20">
                                <Border x:Name="Track" Background="{DynamicResource Bam.Inset}" BorderBrush="{DynamicResource Bam.TextMuted}"
                                        BorderThickness="{StaticResource Bam.BorderWidth}" CornerRadius="10"/>
                                <Border x:Name="Hover" Background="{DynamicResource Bam.PrimaryLight}" CornerRadius="10"
                                        Opacity="0" IsHitTestVisible="False" local:Motion.HoverFeedback="True"/>
                                <Ellipse x:Name="Thumb" Fill="{DynamicResource Bam.TextSecondary}" Width="12" Height="12"
                                         Margin="4,0" HorizontalAlignment="Left"/>
                            </Grid>
                            <ContentPresenter x:Name="Label" Margin="{StaticResource Bam.Gap.Small}" VerticalAlignment="Center"/>
                        </DockPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource Bam.ActionFill}"/>
                            <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource Bam.ActionFill}"/>
                            <Setter TargetName="Thumb" Property="Fill" Value="{DynamicResource Bam.OnAction}"/>
                            <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                        </Trigger>
                        <Trigger Property="Content" Value="{x:Null}">
                            <Setter TargetName="Label" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Bam.PageGrid" TargetType="Grid">
        <Setter Property="Margin" Value="{StaticResource Bam.PagePadding}"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsCompact, RelativeSource={RelativeSource AncestorType=ui:FluentWindow}}" Value="True">
                <Setter Property="Margin" Value="{StaticResource Bam.PagePaddingNarrow}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="Bam.SettingsRow" TargetType="Border">
        <Setter Property="Padding" Value="0,8"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Bam.Border}"/>
        <Setter Property="BorderThickness" Value="0,1,0,0"/>
    </Style>
    <Style x:Key="Bam.SettingsPanel" TargetType="Border" BasedOn="{StaticResource Bam.Panel}">
        <Setter Property="Padding" Value="16,12"/>
        <Setter Property="Margin" Value="{StaticResource Bam.After.Heading}"/>
    </Style>
    <ControlTemplate x:Key="Bam.VerticalScrollBar" TargetType="ScrollBar">
        <Grid Background="Transparent" Margin="0,4">
            <Border x:Name="Rail" Width="10" Background="Transparent" CornerRadius="5"/>
            <Track x:Name="PART_Track" IsDirectionReversed="True">
                <Track.DecreaseRepeatButton>
                    <RepeatButton Command="ScrollBar.PageUpCommand" Style="{StaticResource UiScrollBarPageButton}"/>
                </Track.DecreaseRepeatButton>
                <Track.Thumb>
                    <Thumb MinHeight="24" Focusable="False">
                        <Thumb.Template>
                            <ControlTemplate TargetType="Thumb">
                                <Grid Background="Transparent">
                                    <Border x:Name="Grip" Width="4" CornerRadius="4" Background="{DynamicResource Bam.ScrollThumb}"/>
                                </Grid>
                                <ControlTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ScrollBar}}" Value="True">
                                        <Setter TargetName="Grip" Property="Width" Value="8"/>
                                        <Setter TargetName="Grip" Property="Background" Value="{DynamicResource Bam.TextMuted}"/>
                                    </DataTrigger>
                                    <Trigger Property="IsDragging" Value="True">
                                        <Setter TargetName="Grip" Property="Width" Value="8"/>
                                        <Setter TargetName="Grip" Property="Background" Value="{DynamicResource Bam.TextSecondary}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Thumb.Template>
                    </Thumb>
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                    <RepeatButton Command="ScrollBar.PageDownCommand" Style="{StaticResource UiScrollBarPageButton}"/>
                </Track.IncreaseRepeatButton>
            </Track>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Rail" Property="Background" Value="{DynamicResource Bam.SurfaceHover}"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>
    <Style TargetType="ScrollBar" BasedOn="{StaticResource UiScrollBar}">
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Vertical">
                <Setter Property="Width" Value="14"/>
                <Setter Property="Template" Value="{StaticResource Bam.VerticalScrollBar}"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style TargetType="ContextMenu" BasedOn="{StaticResource UiContextMenu}">
        <Setter Property="Background" Value="{DynamicResource Bam.Surface}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Bam.Border}"/>
        <Setter Property="Foreground" Value="{DynamicResource Bam.TextPrimary}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{StaticResource Bam.BorderWidth}" CornerRadius="{StaticResource Bam.Corner.Control}"
                            Margin="0,0,10,12" Padding="4" Effect="{DynamicResource Bam.PopupShadow}">
                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ToolTip" BasedOn="{StaticResource {x:Type ToolTip}}">
        <Setter Property="Background" Value="{DynamicResource Bam.SurfaceHover}"/>
        <Setter Property="Foreground" Value="{DynamicResource Bam.TextPrimary}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Bam.Border}"/>
        <Setter Property="Padding" Value="{StaticResource Bam.RowPadding}"/>
        <Setter Property="FontFamily" Value="{StaticResource Bam.Font}"/>
        <Setter Property="MaxWidth" Value="320"/>
        <Setter Property="ContentTemplate">
            <Setter.Value>
                <DataTemplate>
                    <TextBlock Text="{Binding}" TextWrapping="Wrap"/>
                </DataTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
