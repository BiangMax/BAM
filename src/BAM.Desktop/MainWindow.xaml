<ui:FluentWindow x:Class="BAM.Desktop.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:vm="clr-namespace:BAM.Desktop.ViewModels"
                 xmlns:views="clr-namespace:BAM.Desktop.Views"
                 xmlns:local="clr-namespace:BAM.Desktop.Controls"
                 Title="BAM" Icon="Assets/Bam.ico" Width="1080" Height="745" MinWidth="800" MinHeight="540"
                 ExtendsContentIntoTitleBar="True" WindowStartupLocation="CenterScreen"
                 FontFamily="{StaticResource Bam.Font}" FontSize="14" Foreground="{DynamicResource Bam.TextPrimary}"
                 UseLayoutRounding="True" SnapsToDevicePixels="True">
    <ui:FluentWindow.Resources>
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <views:DashboardView Loaded="OnPageLoaded"/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ScriptsViewModel}">
            <views:ScriptsView Loaded="OnPageLoaded"/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:LogsViewModel}">
            <views:LogsView Loaded="OnPageLoaded"/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsView Loaded="OnPageLoaded"/>
        </DataTemplate>
    </ui:FluentWindow.Resources>

    <Grid x:Name="Shell">
        <Grid.RowDefinitions>
            <RowDefinition Height="{StaticResource Bam.TitleBarHeight}"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="32"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="RailColumn" Width="188"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <ui:TitleBar Grid.ColumnSpan="2" ForceShutdown="False" ButtonsForeground="{DynamicResource Bam.TextPrimary}"
                     ButtonsBackground="{DynamicResource Bam.SurfaceHover}">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="{StaticResource Bam.Mark}" Width="16" Height="16" Margin="4,0,0,0"/>
            </ui:TitleBar.Icon>
            <ui:TitleBar.Header>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="BAM" Style="{StaticResource Bam.CardTitle}" VerticalAlignment="Center"/>
                    <Border Width="1" Height="14" Margin="10,0" Background="{DynamicResource Bam.Border}"/>
                    <TextBlock Text="Biang 自动化管理器" Style="{StaticResource Bam.Caption}" VerticalAlignment="Center"/>
                </StackPanel>
            </ui:TitleBar.Header>
            <ui:TitleBar.TrailingContent>
                <local:ToneBadge Text="演示模式" Tone="Warning" Margin="{StaticResource Bam.Gap.Right}"
                                 Visibility="{Binding IsDemo, Converter={StaticResource Bam.VisibleWhenTrue}}"/>
            </ui:TitleBar.TrailingContent>
        </ui:TitleBar>

        <Border Grid.Row="1" Background="{DynamicResource Bam.Rail}" BorderBrush="{DynamicResource Bam.Border}" BorderThickness="0,1,1,0">
            <ListBox x:Name="Navigation" ItemsSource="{Binding Navigation}" SelectedItem="{Binding Selected}"
                     AutomationProperties.Name="主导航" Background="Transparent" BorderThickness="0"
                     Margin="10,14,10,0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Disabled" TabIndex="0">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="AutomationProperties.Name" Value="{Binding Label}"/>
                        <Setter Property="ToolTip" Value="{Binding Label}"/>
                        <Setter Property="MinHeight" Value="44"/>
                        <Setter Property="Margin" Value="{StaticResource Bam.After.Small}"/>
                        <Setter Property="FocusVisualStyle" Value="{StaticResource Bam.FocusVisual}"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="NavTile" Background="Transparent" CornerRadius="{StaticResource Bam.Corner.Control}">
                                        <Grid>
                                            <Border x:Name="SelectionMark" Width="3" Height="20" CornerRadius="2"
                                                    HorizontalAlignment="Left" Background="{DynamicResource Bam.PrimaryLight}"
                                                    Visibility="Collapsed"/>
                                            <ContentPresenter Margin="12,0,8,0" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="NavTile" Property="Background" Value="{DynamicResource Bam.SurfaceHover}"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="NavTile" Property="Background" Value="{DynamicResource Bam.AccentSurface}"/>
                                            <Setter TargetName="SelectionMark" Property="Visibility" Value="Visible"/>
                                            <Setter Property="Foreground" Value="{DynamicResource Bam.PrimaryLight}"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="False">
                                            <Setter Property="Foreground" Value="{DynamicResource Bam.TextSecondary}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="{Binding Icon}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"/>
                            <TextBlock Text="{Binding Label}" Margin="{StaticResource Bam.Gap.Left}" Style="{StaticResource Bam.NavigationLabel}"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                       Visibility="{Binding LabelsVisibility, RelativeSource={RelativeSource AncestorType=ui:FluentWindow}}"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <Border Grid.Row="1" Grid.Column="1" Background="{DynamicResource Bam.Background}"
                BorderBrush="{DynamicResource Bam.Border}" BorderThickness="0,1,0,0">
            <ContentControl Content="{Binding Selected.ViewModel}" Focusable="False" IsTabStop="False"
                            HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
        </Border>

        <Border Grid.Row="2" Grid.ColumnSpan="2" Background="{DynamicResource Bam.Rail}"
                BorderBrush="{DynamicResource Bam.Border}" BorderThickness="0,1,0,0" Padding="{StaticResource Bam.ButtonPadding}">
            <DockPanel LastChildFill="True">
                <TextBlock DockPanel.Dock="Right" Text="{Binding VersionLabel}" Style="{StaticResource Bam.Muted}" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Symbol="Pulse24" FontSize="14" Foreground="{DynamicResource Bam.PrimaryLight}"/>
                    <TextBlock Text="{Binding MonitoringStatus}" Margin="{StaticResource Bam.Gap.Small}" Style="{StaticResource Bam.Muted}" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding PermissionLabel}" Margin="{StaticResource Bam.Gap.Left}" Style="{StaticResource Bam.Muted}" VerticalAlignment="Center"/>
                </StackPanel>
                <Button Style="{StaticResource Bam.QuietButton}" Foreground="{DynamicResource Bam.Danger}"
                        Content="{Binding ErrorLabel}" Command="{Binding OpenErrorsCommand}" MinHeight="31"
                        Margin="{StaticResource Bam.Gap.Small}" ToolTip="查看错误日志"
                        AutomationProperties.AutomationId="OpenErrors"
                        Visibility="{Binding HasErrors, Converter={StaticResource Bam.VisibleWhenTrue}}"/>
                <TextBlock Text="{Binding OperationNotice}" ToolTip="{Binding OperationNotice}"
                           Margin="{StaticResource Bam.Gap.Left}" TextTrimming="CharacterEllipsis"
                           AutomationProperties.LiveSetting="Polite" Style="{StaticResource Bam.Muted}" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>
    </Grid>
</ui:FluentWindow>
