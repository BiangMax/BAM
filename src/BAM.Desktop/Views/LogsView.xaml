<UserControl x:Class="BAM.Desktop.Views.LogsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:local="clr-namespace:BAM.Desktop.Controls"
             Focusable="False" IsTabStop="False">
    <Grid Style="{StaticResource Bam.PageGrid}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Margin="{StaticResource Bam.After.Heading}">
            <TextBlock Text="运行日志" Style="{StaticResource Bam.PageTitle}" AutomationProperties.HeadingLevel="Level1"/>
            <TextBlock Text="筛选事件并查看原始详情" Style="{StaticResource Bam.Caption}"/>
        </StackPanel>

        <Grid Grid.Row="1" Margin="{StaticResource Bam.After.Heading}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="136"/>
                <ColumnDefinition Width="122"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <ComboBox ItemsSource="{Binding Sources}" SelectedItem="{Binding Source}" Style="{StaticResource Bam.Combo}"
                      Margin="{StaticResource Bam.Gap.Right}" AutomationProperties.Name="日志来源" AutomationProperties.AutomationId="LogSource"/>
            <ComboBox Grid.Column="1" ItemsSource="{Binding Levels}" SelectedItem="{Binding Level}" Style="{StaticResource Bam.Combo}"
                      Margin="{StaticResource Bam.Gap.Right}" AutomationProperties.Name="日志级别" AutomationProperties.AutomationId="LogLevel"/>
            <ui:TextBox Grid.Column="2" Text="{Binding Query, UpdateSourceTrigger=PropertyChanged, Delay=120}"
                        Style="{StaticResource Bam.Input}" PlaceholderText="搜索来源或内容" ClearButtonEnabled="True"
                        AutomationProperties.Name="搜索日志" AutomationProperties.AutomationId="LogSearch"/>
            <ToggleButton Grid.Column="3" Content="自动滚动" Style="{StaticResource Bam.Switch}"
                             Foreground="{DynamicResource Bam.TextSecondary}" Margin="{StaticResource Bam.Gap.Left}"
                             IsChecked="{Binding Follow}" VerticalAlignment="Center"
                             AutomationProperties.Name="自动滚动" AutomationProperties.AutomationId="LogFollow"/>
        </Grid>

        <Border Grid.Row="2" Style="{StaticResource Bam.Panel}" Background="{DynamicResource Bam.DangerSurface}"
                Padding="{StaticResource Bam.RowPadding}" Margin="{StaticResource Bam.After.Heading}"
                Visibility="{Binding HasSourceNotice, Converter={StaticResource Bam.VisibleWhenTrue}}">
            <DockPanel>
                <ui:SymbolIcon Symbol="ErrorCircle24" FontSize="16" Margin="{StaticResource Bam.Gap.Right}" Foreground="{DynamicResource Bam.Danger}"/>
                <TextBlock Text="{Binding SourceNotice}" Foreground="{DynamicResource Bam.Danger}" TextWrapping="Wrap"/>
            </DockPanel>
        </Border>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="5*"/>
                <ColumnDefinition Width="{StaticResource Bam.ColumnGutter}"/>
                <ColumnDefinition Width="3*" MinWidth="190" MaxWidth="310"/>
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource Bam.Panel}" Padding="0">
                <Grid>
                    <DockPanel Visibility="{Binding HasResults, Converter={StaticResource Bam.VisibleWhenTrue}}">
                        <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource Bam.Border}" BorderThickness="0,0,0,1"
                                Padding="{StaticResource Bam.RowPadding}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="70"/>
                                    <ColumnDefinition Width="84"/>
                                    <ColumnDefinition Width="64"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="时间" Style="{StaticResource Bam.Muted}"/>
                                <TextBlock Grid.Column="1" Text="来源" Style="{StaticResource Bam.Muted}"/>
                                <TextBlock Grid.Column="2" Text="级别" Style="{StaticResource Bam.Muted}"/>
                                <TextBlock Grid.Column="3" Text="事件" Style="{StaticResource Bam.Muted}"/>
                            </Grid>
                        </Border>
                        <ListBox x:Name="LogList" Style="{StaticResource Bam.DataList}" ItemsSource="{Binding Entries}"
                                 SelectedItem="{Binding Selected}" AutomationProperties.Name="日志记录"
                                 AutomationProperties.AutomationId="LogEntries" ScrollViewer.ScrollChanged="OnScrollChanged">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid AutomationProperties.Name="{Binding AccessibleName}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="70"/>
                                            <ColumnDefinition Width="84"/>
                                            <ColumnDefinition Width="64"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Clock}" Style="{StaticResource Bam.MonoText}" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Source}" Style="{StaticResource Bam.Caption}" VerticalAlignment="Center"/>
                                        <local:ToneBadge Grid.Column="2" Text="{Binding LevelLabel}" Tone="{Binding Tone}"/>
                                        <TextBlock Grid.Column="3" Text="{Binding Message}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                    <local:EmptyState Title="{Binding EmptyLabel}" Description="{Binding EmptyHint}" Symbol="DocumentText24">
                        <local:EmptyState.Style>
                            <Style TargetType="local:EmptyState" BasedOn="{StaticResource {x:Type local:EmptyState}}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasResults}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </local:EmptyState.Style>
                    </local:EmptyState>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Bam.Panel}" Padding="0">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="{StaticResource Bam.PanelPadding}">
                        <TextBlock Text="事件详情" Style="{StaticResource Bam.SectionTitle}" Margin="{StaticResource Bam.After.Heading}"
                                   AutomationProperties.HeadingLevel="Level2"/>
                        <TextBlock Text="选择一条日志以查看详情。" TextWrapping="Wrap">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Bam.Caption}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasSelection}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <StackPanel Visibility="{Binding HasSelection, Converter={StaticResource Bam.VisibleWhenTrue}}">
                            <local:ToneBadge Text="{Binding Selected.LevelLabel}" Tone="{Binding Selected.Tone}" Margin="{StaticResource Bam.After.Medium}"/>
                            <TextBlock Text="{Binding Selected.Message}" Style="{StaticResource Bam.CardTitle}" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding Selected.Timestamp}" Style="{StaticResource Bam.MonoText}" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding Selected.Source}" Style="{StaticResource Bam.Caption}" Margin="{StaticResource Bam.After.Heading}"/>
                            <Border Style="{StaticResource Bam.Panel}" Background="{DynamicResource Bam.Inset}" Padding="{StaticResource Bam.RowPadding}">
                                <TextBlock Text="{Binding Selected.Detail}" Style="{StaticResource Bam.BodyCopy}" Foreground="{DynamicResource Bam.TextSecondary}"/>
                            </Border>
                            <Button Content="复制记录" Command="{Binding CopyCommand}" HorizontalAlignment="Left" Margin="{StaticResource Bam.Before.Large}"/>
                            <TextBlock Text="{Binding CopyNotice}" Style="{StaticResource Bam.Caption}" TextWrapping="Wrap" Margin="{StaticResource Bam.Before.Small}"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <DockPanel Grid.Row="4" Margin="{StaticResource Bam.Before.Medium}">
            <TextBlock DockPanel.Dock="Right" Text="{Binding LimitLabel}" Style="{StaticResource Bam.Muted}"
                       AutomationProperties.AutomationId="LogRetention"
                       ToolTip="略过的数量按本次读取的日志文件和本次运行新增的记录统计。"/>
            <TextBlock Text="{Binding CountLabel}" Style="{StaticResource Bam.Muted}"/>
        </DockPanel>
    </Grid>
</UserControl>
