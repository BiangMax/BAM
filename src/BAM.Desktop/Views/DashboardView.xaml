<UserControl x:Class="BAM.Desktop.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:local="clr-namespace:BAM.Desktop.Controls"
             xmlns:views="clr-namespace:BAM.Desktop.Views"
             Focusable="False" IsTabStop="False">
    <Grid Margin="{StaticResource Bam.DashboardPadding}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <ScrollViewer x:Name="OverviewScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      AutomationProperties.Name="总览内容">
            <StackPanel>
                <DockPanel Margin="{StaticResource Bam.After.Small}">
                    <TextBlock DockPanel.Dock="Right" Text="{Binding SampleLabel}" Style="{StaticResource Bam.Muted}"
                           VerticalAlignment="Center"/>
                    <TextBlock Text="总览" Style="{StaticResource Bam.PageTitle}" AutomationProperties.HeadingLevel="Level1"/>
                </DockPanel>

                <local:ResponsivePanel ItemWidth="176" Margin="{StaticResource Bam.After.Medium}" AutomationProperties.Name="摘要">
                    <local:ResponsivePanel.Style>
                        <Style TargetType="local:ResponsivePanel">
                            <Setter Property="MaxColumns" Value="4"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsCompact, RelativeSource={RelativeSource AncestorType=ui:FluentWindow}}" Value="True">
                                    <Setter Property="MaxColumns" Value="2"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </local:ResponsivePanel.Style>
                    <local:MetricTile Label="已启动 / 已管理" Symbol="Apps24" Value="{Binding ProcessCount}" Detail="{Binding ProcessHint}"/>
                    <local:MetricTile Label="任务观测" Symbol="Target24" Value="{Binding TaskCount}" Detail="{Binding TaskSummary}"/>
                    <local:MetricTile Label="CPU占用" Symbol="TopSpeed24" Value="{Binding Cpu}" Detail="{Binding CpuScope}"/>
                    <local:MetricTile Label="内存占用" Symbol="Database24" Value="{Binding Memory}" Detail="{Binding MemoryScope}"/>
                </local:ResponsivePanel>

                <StackPanel KeyboardNavigation.TabNavigation="Local">
                    <DockPanel Margin="{StaticResource Bam.After.Small}">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Style="{StaticResource Bam.SectionLink}" Content="批量启动" Margin="{StaticResource Bam.Gap.Right}"
                                    Visibility="{Binding CanManage, Converter={StaticResource Bam.VisibleWhenTrue}}"
                                    AutomationProperties.AutomationId="LaunchPaired"
                                    ToolTip="按卡片顺序依次启动可用的脚本。MAA 按原设置启动。"
                                    ToolTipService.ShowOnDisabled="True"
                                    Command="{Binding DataContext.LaunchPairedCommand, RelativeSource={RelativeSource AncestorType=ui:FluentWindow}}"/>
                            <Button Style="{StaticResource Bam.SectionLink}" Content="批量关闭" Margin="{StaticResource Bam.Gap.Right}"
                                    Visibility="{Binding CanManage, Converter={StaticResource Bam.VisibleWhenTrue}}"
                                    AutomationProperties.AutomationId="CloseBatch"
                                    Command="{Binding DataContext.CloseBatchCommand, RelativeSource={RelativeSource AncestorType=ui:FluentWindow}}"/>
                            <Button Style="{StaticResource Bam.SectionLink}" Content="管理脚本"
                                    Command="{Binding DataContext.OpenScriptsCommand, RelativeSource={RelativeSource AncestorType=ui:FluentWindow}}"/>
                        </StackPanel>
                        <TextBlock Text="已管理脚本" Style="{StaticResource Bam.SectionTitle}" VerticalAlignment="Center"
                                   AutomationProperties.HeadingLevel="Level2"/>
                    </DockPanel>
                    <ItemsControl ItemsSource="{Binding Cards}"
                                  Visibility="{Binding HasScripts, Converter={StaticResource Bam.VisibleWhenTrue}}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <local:ResponsivePanel ItemWidth="{StaticResource Bam.CardMinWidth}">
                                    <local:ResponsivePanel.Style>
                                        <Style TargetType="local:ResponsivePanel">
                                            <Setter Property="MaxColumns" Value="3"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsCompact, RelativeSource={RelativeSource AncestorType=ui:FluentWindow}}" Value="True">
                                                    <Setter Property="MaxColumns" Value="1"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </local:ResponsivePanel.Style>
                                </local:ResponsivePanel>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate><views:ScriptCard/></DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Border>
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource Bam.Panel}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasScripts}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel x:Name="ScriptStatus">
                            <local:EmptyState Title="{Binding DetectionTitle}" Description="{Binding DetectionDescription}" Symbol="Apps24"
                                              AutomationProperties.LiveSetting="Polite"/>
                            <WrapPanel HorizontalAlignment="Center" Margin="{StaticResource Bam.Before.Small}">
                                <WrapPanel.Style>
                                    <Style TargetType="WrapPanel">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding CanManage}" Value="True"/>
                                                    <Condition Binding="{Binding IsDetecting}" Value="False"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </WrapPanel.Style>
                                <Button Content="自动检测" Style="{StaticResource Bam.QuietButton}" Margin="{StaticResource Bam.Gap.Right}"
                                        Command="{Binding DataContext.DiscoverCommand, RelativeSource={RelativeSource AncestorType=ui:FluentWindow}}"/>
                                <Button Content="手动添加" Style="{StaticResource Bam.QuietButton}"
                                        Command="{Binding DataContext.AddScriptCommand, RelativeSource={RelativeSource AncestorType=ui:FluentWindow}}"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="1" Margin="{StaticResource Bam.Before.Small}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="5*"/>
                <ColumnDefinition Width="{StaticResource Bam.ColumnGutter}"/>
                <ColumnDefinition Width="4*"/>
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource Bam.DensePanel}" KeyboardNavigation.TabNavigation="Local">
                <StackPanel>
                    <DockPanel Margin="{StaticResource Bam.After.Small}">
                        <Border DockPanel.Dock="Right" Style="{StaticResource Bam.SegmentGroup}">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Style="{StaticResource Bam.Segment}" Content="CPU" GroupName="Metric"
                                                 AutomationProperties.AutomationId="ChartCpu" IsChecked="{Binding ShowCpu, Mode=TwoWay}"/>
                                <RadioButton Style="{StaticResource Bam.Segment}" Content="内存" GroupName="Metric"
                                                 AutomationProperties.AutomationId="ChartMemory" IsChecked="{Binding ShowMemory, Mode=TwoWay}"/>
                            </StackPanel>
                        </Border>
                            <TextBlock Text="资源监控" Style="{StaticResource Bam.SectionTitle}" VerticalAlignment="Center"
                                       ToolTip="{Binding ChartScope}" AutomationProperties.HeadingLevel="Level2"/>
                    </DockPanel>
                    <Grid Height="80">
                        <local:ResourceChart x:Name="ResourcePlot" History="{Binding History}" Revision="{Binding ChartRevision}"
                                                 ShowMemory="{Binding ShowMemory}" Focusable="{Binding HasChartSamples}"
                                                 Visibility="{Binding HasChartSamples, Converter={StaticResource Bam.VisibleWhenTrue}}"
                                                 FocusVisualStyle="{StaticResource Bam.FocusVisual}"
                                                 AxisBrush="{DynamicResource Bam.TextMuted}" GridBrush="{DynamicResource Bam.ChartGrid}"
                                                 CpuBrush="{DynamicResource Bam.PrimaryLight}" MemoryBrush="{DynamicResource Bam.Memory}"
                                                 AutomationProperties.Name="最近 120 秒资源曲线" AutomationProperties.HelpText="{Binding ChartDetail}"
                                                 KeyboardNavigation.TabNavigation="Local"/>
                        <Border x:Name="ChartEmptyState" Background="{DynamicResource Bam.Inset}" BorderBrush="{DynamicResource Bam.PanelEdge}"
                                BorderThickness="{StaticResource Bam.BorderWidth}" Padding="{StaticResource Bam.DensePanelPadding}"
                                CornerRadius="{StaticResource Bam.Corner.Control}" IsHitTestVisible="False"
                                AutomationProperties.AutomationId="ChartEmptyState" AutomationProperties.LiveSetting="Polite">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasChartSamples}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <DockPanel VerticalAlignment="Center">
                                <Border DockPanel.Dock="Left" Width="36" Height="36" Margin="{StaticResource Bam.Gap.Right}"
                                        Background="{DynamicResource Bam.AccentSurface}" CornerRadius="{StaticResource Bam.Corner.Control}">
                                    <ui:SymbolIcon Symbol="TopSpeed24" FontSize="21" HorizontalAlignment="Center" Foreground="{DynamicResource Bam.PrimaryLight}"/>
                                </Border>
                                <StackPanel>
                                    <TextBlock Text="{Binding ChartEmptyTitle}" Style="{StaticResource Bam.Value}" Margin="{StaticResource Bam.After.Small}"/>
                                    <TextBlock Text="{Binding ChartEmptyHint}" Style="{StaticResource Bam.Caption}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </Grid>
                    <DockPanel LastChildFill="False">
                        <TextBlock TextWrapping="Wrap" Text="{Binding Inspection, ElementName=ResourcePlot, TargetNullValue='最近 120 秒'}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Bam.Muted}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasChartSamples}" Value="False">
                                            <Setter Property="Visibility" Value="Hidden"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock DockPanel.Dock="Right" Margin="{StaticResource Bam.Gap.Left}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Bam.Muted}">
                                    <Setter Property="Text" Value="内存占用 · MiB"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ShowMemory}" Value="False">
                                            <Setter Property="Text" Value="CPU · %"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </DockPanel>
                </StackPanel>
            </Border>

            <Border x:Name="EventPreview" Grid.Column="2" Style="{StaticResource Bam.DensePanel}" KeyboardNavigation.TabNavigation="Local">
                <StackPanel>
                    <DockPanel Margin="{StaticResource Bam.After.Small}">
                        <Button DockPanel.Dock="Right" Style="{StaticResource Bam.SectionLink}" Content="查看日志"
                                Command="{Binding DataContext.OpenLogsCommand, RelativeSource={RelativeSource AncestorType=ui:FluentWindow}}"/>
                        <TextBlock Text="最近运行事件" Style="{StaticResource Bam.SectionTitle}" VerticalAlignment="Center"
                                   AutomationProperties.HeadingLevel="Level2"/>
                    </DockPanel>
                    <Border BorderBrush="{DynamicResource Bam.PanelEdge}" BorderThickness="0,1,0,0"/>
                    <Grid>
                        <ItemsControl ItemsSource="{Binding RecentEvents}" Visibility="{Binding HasEvents, Converter={StaticResource Bam.VisibleWhenTrue}}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="{StaticResource Bam.EventRowPadding}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="62"/>
                                            <ColumnDefinition Width="22"/>
                                            <ColumnDefinition Width="70"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Clock}" VerticalAlignment="Center" Style="{StaticResource Bam.MonoText}"/>
                                        <ui:SymbolIcon Grid.Column="1" Symbol="{Binding Icon}" FontSize="16"/>
                                        <TextBlock Grid.Column="2" Text="{Binding Source}" Style="{StaticResource Bam.Caption}"
                                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip="{Binding Source}"/>
                                        <TextBlock Grid.Column="3" Text="{Binding Message}" TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center" ToolTip="{Binding Message}"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="暂无运行事件" Margin="{StaticResource Bam.Before.Medium}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Bam.Caption}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasEvents}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
