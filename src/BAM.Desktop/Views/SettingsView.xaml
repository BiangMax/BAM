<UserControl x:Class="BAM.Desktop.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:local="clr-namespace:BAM.Desktop.Controls"
             Focusable="False" IsTabStop="False">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="设置内容">
        <Grid Style="{StaticResource Bam.PageGrid}">
            <StackPanel>
                <TextBlock Text="设置" Style="{StaticResource Bam.PageTitle}" Margin="{StaticResource Bam.After.Heading}"
                           AutomationProperties.HeadingLevel="Level1"/>
                <TextBlock Text="{Binding Notice}" Foreground="{DynamicResource Bam.Warning}" TextWrapping="Wrap">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource Bam.Caption}">
                            <Setter Property="Margin" Value="{StaticResource Bam.After.Heading}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Notice}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <Border Style="{StaticResource Bam.SettingsPanel}">
                    <StackPanel>
                        <DockPanel Margin="{StaticResource Bam.After.Medium}">
                            <ui:SymbolIcon Symbol="Color24" Foreground="{DynamicResource Bam.PrimaryLight}" Margin="{StaticResource Bam.Gap.Right}"/>
                            <TextBlock Text="外观" Style="{StaticResource Bam.SectionTitle}" AutomationProperties.HeadingLevel="Level2"/>
                        </DockPanel>
                        <Border Style="{StaticResource Bam.SettingsRow}">
                            <DockPanel>
                                <ComboBox DockPanel.Dock="Right" Width="142" Style="{StaticResource Bam.Combo}"
                                          ItemsSource="{Binding ThemeOptions}" SelectedValuePath="Value" DisplayMemberPath="Label"
                                          SelectedValue="{Binding Theme}" AutomationProperties.Name="应用主题"
                                          AutomationProperties.AutomationId="ThemeChoice" VerticalAlignment="Center">
                                    <ComboBox.ItemContainerStyle>
                                        <Style TargetType="ComboBoxItem" BasedOn="{StaticResource DefaultComboBoxItemStyle}">
                                            <Setter Property="AutomationProperties.Name" Value="{Binding Label}"/>
                                        </Style>
                                    </ComboBox.ItemContainerStyle>
                                </ComboBox>
                                <StackPanel>
                                    <TextBlock Text="应用主题" Style="{StaticResource Bam.Value}"/>
                                    <TextBlock Text="深色、浅色或跟随 Windows 应用主题。" Style="{StaticResource Bam.Caption}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <Border Style="{StaticResource Bam.SettingsRow}" Padding="0,8,0,0">
                            <DockPanel>
                                <ToggleButton Style="{StaticResource Bam.Switch}" DockPanel.Dock="Right" IsChecked="{Binding ReduceMotion}" VerticalAlignment="Center"
                                                 AutomationProperties.Name="减少动画" AutomationProperties.AutomationId="ReduceMotion"/>
                                <StackPanel>
                                    <TextBlock Text="减少动画" Style="{StaticResource Bam.Value}"/>
                                    <TextBlock Text="关闭页面过渡和控件反馈动画。" Style="{StaticResource Bam.Caption}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Bam.SettingsPanel}">
                    <StackPanel>
                        <DockPanel Margin="{StaticResource Bam.After.Medium}">
                            <ui:SymbolIcon Symbol="Pulse24" Foreground="{DynamicResource Bam.PrimaryLight}" Margin="{StaticResource Bam.Gap.Right}"/>
                            <TextBlock Text="监控" Style="{StaticResource Bam.SectionTitle}" AutomationProperties.HeadingLevel="Level2"/>
                        </DockPanel>
                        <Border Style="{StaticResource Bam.SettingsRow}" Padding="0,8,0,0">
                            <DockPanel>
                                <ToggleButton Style="{StaticResource Bam.Switch}" DockPanel.Dock="Right" IsChecked="{Binding CollectResources}"
                                              IsEnabled="{Binding CanCollectResources}"
                                              VerticalAlignment="Center" AutomationProperties.Name="脚本资源采样" AutomationProperties.AutomationId="CollectResources"/>
                                <StackPanel>
                                    <TextBlock Text="脚本资源采样" Style="{StaticResource Bam.Value}"/>
                                    <TextBlock Text="{Binding ResourceDescription}" Style="{StaticResource Bam.Caption}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Bam.SettingsPanel}">
                    <StackPanel>
                        <DockPanel Margin="{StaticResource Bam.After.Medium}">
                            <ui:SymbolIcon Symbol="Window24" Foreground="{DynamicResource Bam.PrimaryLight}" Margin="{StaticResource Bam.Gap.Right}"/>
                            <TextBlock Text="系统托盘" Style="{StaticResource Bam.SectionTitle}" AutomationProperties.HeadingLevel="Level2"/>
                        </DockPanel>
                        <Border Style="{StaticResource Bam.SettingsRow}" Padding="0,8,0,0">
                            <DockPanel>
                                <ToggleButton Style="{StaticResource Bam.Switch}" DockPanel.Dock="Right" IsChecked="{Binding CloseToTray}" VerticalAlignment="Center"
                                                 AutomationProperties.Name="关闭时收起到托盘" AutomationProperties.AutomationId="CloseToTray"/>
                                <StackPanel>
                                    <TextBlock Text="关闭时收起到托盘" Style="{StaticResource Bam.Value}"/>
                                    <TextBlock Text="双击托盘图标恢复。可从托盘菜单退出 BAM。" Style="{StaticResource Bam.Caption}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Bam.SettingsPanel}">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="管理脚本" Style="{StaticResource Bam.QuietButton}"
                                Command="{Binding DataContext.OpenScriptsCommand, RelativeSource={RelativeSource AncestorType=ui:FluentWindow}}"/>
                        <ui:SymbolIcon Symbol="FolderOpen24" Foreground="{DynamicResource Bam.PrimaryLight}" Margin="{StaticResource Bam.Gap.Right}"/>
                        <StackPanel>
                            <TextBlock Text="脚本配置" Style="{StaticResource Bam.SectionTitle}" AutomationProperties.HeadingLevel="Level2"/>
                            <TextBlock Text="查看安装、启动入口和参数。" Style="{StaticResource Bam.Caption}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <Border Style="{StaticResource Bam.SettingsPanel}" Margin="0">
                    <StackPanel>
                        <TextBlock Text="关于 BAM" Style="{StaticResource Bam.SectionTitle}" Margin="{StaticResource Bam.After.Medium}"
                                   AutomationProperties.HeadingLevel="Level2"/>
                        <Border Style="{StaticResource Bam.SettingsRow}" Padding="0,8,0,0">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Style="{StaticResource Bam.QuietButton}" Command="{Binding OpenRepositoryCommand}"
                                        AutomationProperties.Name="打开 BAM GitHub 仓库" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="GitHub 仓库" Foreground="{DynamicResource Bam.PrimaryLight}"/>
                                        <ui:SymbolIcon Symbol="Open24" FontSize="16" Foreground="{DynamicResource Bam.PrimaryLight}" Margin="{StaticResource Bam.Gap.Small}"/>
                                    </StackPanel>
                                </Button>
                                <Image DockPanel.Dock="Left" Source="{StaticResource Bam.Mark}" Width="40" Height="40" Margin="{StaticResource Bam.Gap.Right}"/>
                                <StackPanel>
                                    <TextBlock Text="Biang Automation Manager" Style="{StaticResource Bam.CardTitle}" TextWrapping="Wrap"/>
                                    <TextBlock Text="One Hub, All Scripts." Style="{StaticResource Bam.Caption}"/>
                                    <TextBlock Text="{Binding VersionLabel}" Style="{StaticResource Bam.MonoText}"/>
                                    <TextBlock Text="{Binding LinkNotice}" TextWrapping="Wrap">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource Bam.Caption}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding LinkNotice}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
