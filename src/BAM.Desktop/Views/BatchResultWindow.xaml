<Window x:Class="BAM.Desktop.Views.BatchResultWindow" x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="上次批量启动结果" Width="480" Height="360" MinWidth="280" MinHeight="200"
        WindowStartupLocation="CenterOwner" UseLayoutRounding="True" FocusManager.FocusedElement="{Binding ElementName=CloseReport}"
        FontFamily="{StaticResource Bam.Font}" FontSize="14"
        Background="{DynamicResource Bam.Background}" Foreground="{DynamicResource Bam.TextPrimary}">
    <Grid Margin="{StaticResource Bam.PanelPadding}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="{Binding Summary}" Style="{StaticResource Bam.SectionTitle}" Margin="{StaticResource Bam.After.Medium}"/>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      AutomationProperties.Name="各组启动结果">
            <ItemsControl ItemsSource="{Binding Rows}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="{StaticResource Bam.After.Medium}">
                            <TextBlock Style="{StaticResource Bam.BodyCopy}" FontWeight="{StaticResource Bam.Weight.Emphasis}">
                                <TextBlock.Text>
                                    <MultiBinding StringFormat="{}{0} · {1}">
                                        <Binding Path="Name"/>
                                        <Binding Path="Status"/>
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                            <TextBlock Text="{Binding Detail}" Style="{StaticResource Bam.BodyCopy}" Foreground="{DynamicResource Bam.TextSecondary}"/>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
        <Button Grid.Row="2" x:Name="CloseReport" Content="关闭" IsCancel="True" Style="{StaticResource Bam.QuietButton}"
                HorizontalAlignment="Right" MinWidth="72"/>
    </Grid>
</Window>
