<Window x:Class="BAM.Desktop.Views.ProgramEditor"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="管理软件配置" Width="560" SizeToContent="Height" MaxHeight="720"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner" UseLayoutRounding="True"
        FontFamily="{StaticResource Bam.Font}" FontSize="14"
        Background="{DynamicResource Bam.Background}" Foreground="{DynamicResource Bam.TextPrimary}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="{StaticResource Bam.PanelPadding}">
            <TextBlock Text="管理软件配置" Style="{StaticResource Bam.SectionTitle}" Margin="{StaticResource Bam.After.Medium}"/>
            <TextBlock Text="启动入口" Style="{StaticResource Bam.FieldLabel}"/>
            <DockPanel Margin="{StaticResource Bam.After.Medium}">
                <Button DockPanel.Dock="Right" Content="选择文件" Click="ChooseEntry" Margin="{StaticResource Bam.Gap.Left}"/>
                <TextBox x:Name="EntryPath" IsReadOnly="True" AutomationProperties.Name="启动入口"/>
            </DockPanel>
            <TextBlock Text="软件名称" Style="{StaticResource Bam.FieldLabel}"/>
            <TextBox x:Name="ProgramName" MaxLength="80" AutomationProperties.Name="软件名称" Margin="{StaticResource Bam.After.Medium}"/>
            <TextBlock Text="工作目录" Style="{StaticResource Bam.FieldLabel}"/>
            <CheckBox x:Name="InheritDirectory" Content="工作目录跟随快捷方式" Visibility="Collapsed" Margin="{StaticResource Bam.After.Small}"/>
            <DockPanel Margin="{StaticResource Bam.After.Medium}">
                <DockPanel.Style>
                    <Style TargetType="DockPanel">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsChecked, ElementName=InheritDirectory}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DockPanel.Style>
                <Button DockPanel.Dock="Right" Content="选择目录" Click="ChooseDirectory" Margin="{StaticResource Bam.Gap.Left}"/>
                <TextBox x:Name="WorkDirectory" AutomationProperties.Name="工作目录"/>
            </DockPanel>
            <TextBlock Text="启动参数" Style="{StaticResource Bam.FieldLabel}"/>
            <CheckBox x:Name="InheritArguments" Content="启动参数跟随快捷方式" Visibility="Collapsed" Margin="{StaticResource Bam.After.Small}"/>
            <TextBox x:Name="LaunchArguments" MaxLength="4096" AutomationProperties.Name="启动参数" Margin="{StaticResource Bam.After.Medium}">
                <TextBox.Style>
                    <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsChecked, ElementName=InheritArguments}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBox.Style>
            </TextBox>
            <TextBlock Text="实际工作程序 EXE（启动器或脚本可指定）" Style="{StaticResource Bam.FieldLabel}"/>
            <DockPanel Margin="{StaticResource Bam.After.Medium}">
                <Button DockPanel.Dock="Right" Content="选择 EXE" Click="ChooseWorker" Margin="{StaticResource Bam.Gap.Left}"/>
                <TextBox x:Name="WorkerPath" AutomationProperties.Name="实际工作程序"/>
            </DockPanel>
            <StackPanel x:Name="EmulatorSettings" Visibility="Collapsed" Margin="{StaticResource Bam.Before.Medium}">
                <TextBlock Text="模拟器启动（可选）" Style="{StaticResource Bam.SectionTitle}"/>
                <TextBlock Text="选择能直接打开对应实例的快捷方式。BAM 会使用其中的参数。"
                           Style="{StaticResource Bam.Muted}" TextWrapping="Wrap" Margin="{StaticResource Bam.After.Small}"/>
                <DockPanel Margin="{StaticResource Bam.After.Medium}">
                    <Button x:Name="ChooseEmulatorButton" DockPanel.Dock="Right" Content="选择入口" Click="ChooseEmulator"
                            Margin="{StaticResource Bam.Gap.Left}"/>
                    <Button x:Name="ClearEmulatorButton" DockPanel.Dock="Right" Content="清除" Click="ClearEmulator"
                            Margin="{StaticResource Bam.Gap.Left}"/>
                    <TextBox x:Name="EmulatorPath" IsReadOnly="True" AutomationProperties.Name="模拟器启动入口"/>
                </DockPanel>
                <TextBlock Text="模拟器启动参数" Style="{StaticResource Bam.FieldLabel}"/>
                <TextBox x:Name="EmulatorArguments" MaxLength="4096" AutomationProperties.Name="模拟器启动参数"
                         Margin="{StaticResource Bam.After.Medium}"/>
                <TextBlock Text="等待后启动软件（秒）" Style="{StaticResource Bam.FieldLabel}"/>
                <TextBox x:Name="EmulatorWait" MaxLength="3" Width="72" HorizontalAlignment="Left"
                         AutomationProperties.Name="等待后启动软件的秒数"/>
            </StackPanel>
            <StackPanel Margin="{StaticResource Bam.Before.Medium}">
                <TextBlock Text="模拟器资源监控（可选）" Style="{StaticResource Bam.SectionTitle}"/>
                <TextBlock Text="选择运行中的实例进程。需要联动关闭时，请选择带实例窗口的 EXE。同一 EXE 对应多个实例时，填写多开器中的实例编号。"
                           Style="{StaticResource Bam.Caption}" TextWrapping="Wrap" Margin="{StaticResource Bam.After.Medium}"/>
                <TextBlock Text="模拟器 EXE" Style="{StaticResource Bam.FieldLabel}"/>
                <DockPanel Margin="{StaticResource Bam.After.Medium}">
                    <Button x:Name="ChooseMonitorImageButton" DockPanel.Dock="Right" Content="选择 EXE" Click="ChooseEmulatorMonitor"
                            AutomationProperties.Name="选择模拟器实例进程 EXE" Margin="{StaticResource Bam.Gap.Left}"/>
                    <Button DockPanel.Dock="Right" Content="清除" Click="ClearEmulatorMonitor" Margin="{StaticResource Bam.Gap.Left}"/>
                    <TextBox x:Name="MonitorImage" IsReadOnly="True" AutomationProperties.Name="模拟器监控 EXE"/>
                </DockPanel>
                <TextBlock Text="虚拟机进程 EXE（可选，计入占用）" Style="{StaticResource Bam.FieldLabel}"/>
                <DockPanel Margin="{StaticResource Bam.After.Medium}">
                    <Button x:Name="ChooseMonitorWorkerButton" DockPanel.Dock="Right" Content="选择 EXE"
                            Click="ChooseEmulatorMonitor" Margin="{StaticResource Bam.Gap.Left}"/>
                    <Button x:Name="ClearMonitorWorkerButton" DockPanel.Dock="Right" Content="清除"
                            Click="ClearEmulatorMonitor" Margin="{StaticResource Bam.Gap.Left}"/>
                    <TextBox x:Name="MonitorWorker" IsReadOnly="True" AutomationProperties.Name="虚拟机进程 EXE"/>
                </DockPanel>
                <TextBlock Text="实例编号（单实例可留空）" Style="{StaticResource Bam.FieldLabel}"/>
                <TextBox x:Name="MonitorInstance" MaxLength="10" Width="90" HorizontalAlignment="Left"
                         AutomationProperties.Name="模拟器实例编号"/>
            </StackPanel>
            <TextBlock x:Name="EditorNotice" Foreground="{DynamicResource Bam.Warning}" TextWrapping="Wrap"
                       AutomationProperties.LiveSetting="Polite" Margin="{StaticResource Bam.After.Medium}"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="取消" IsCancel="True" Margin="{StaticResource Bam.Gap.Right}"/>
                <Button x:Name="SaveButton" Style="{StaticResource Bam.PrimaryButton}" Content="保存配置" IsDefault="True"
                        Click="Save" IsEnabled="False"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Window>
